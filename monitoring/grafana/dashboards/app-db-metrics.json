{
  "title": "Application & Database",
  "tags": ["app", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "App Memory Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "container_memory_usage_bytes{name=~\"myapp.*\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 2,
      "title": "Postgres Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(pg_stat_activity_count) by (datname)", "legendFormat": "{{datname}}" }
      ]
    },
    {
      "id": 3,
      "title": "Postgres Up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "pg_up" }
      ]
    },
    {
      "id": 4,
      "title": "Application Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "targets": [
        { "expr": "{job=\"docker\", host=\"app\"}" }
      ]
    }
  ]
}
